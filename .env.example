# Local development settings. Copy this file to .env and use real values.
# Never commit .env or paste these values into frontend files.
MISTIZEN_ENV=development
MISTIZEN_SECRET_KEY=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Leave empty locally. Set this to the exact public callback URL after deployment.
GOOGLE_REDIRECT_URI=

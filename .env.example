# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# ── Core security ────────────────────────────────────────────────────────────
# Required in production. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MISTIZEN_SECRET_KEY=

# Set to "production" in production (enables HTTPS cookies, HSTS).
MISTIZEN_ENV=development

# Comma-separated admin emails that get the admin dashboard.
MISTIZEN_ADMIN_EMAILS=

# ── Google OAuth sign-in ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For local dev add this exact redirect URI in Google Cloud Console:
#   http://localhost:5000/api/auth/google/callback
# For production use https://YOUR-SITE.com/api/auth/google/callback
# The app accepts BOTH GOOGLE_REDIRECT_URI and GOOGLE_REDIRECT_URL keys.
GOOGLE_REDIRECT_URI=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# e.g. Gmail app password, or a transactional provider like SendGrid/Brevo.
MISTIZEN_SMTP_HOST=
MISTIZEN_SMTP_PORT=587
MISTIZEN_SMTP_USERNAME=
MISTIZEN_SMTP_PASSWORD=
MISTIZEN_SMTP_FROM=
MISTIZEN_SUPPORT_EMAIL=kchoppa182@gmail.com

# ── Database ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty for local SQLite (mistizen.db).
# For production use a managed PostgreSQL, e.g.:
#   postgresql://user:pass@host:5432/dbname
DATABASE_URL=
MISTIZEN_DB_PATH=mistizen.db

# ── Notifications: WhatsApp + SMS ────────────────────────────────────────────
# Business WhatsApp number (digits only, international format).
# e.g. 254712345678  → customers get a "Chat on WhatsApp" link
MISTIZEN_BUSINESS_WHATSAPP=

# Africa's Talking SMS (optional). Set both to enable SMS notifications.
# Get keys at https://account.africastalking.com
AT_API_KEY=
AT_USERNAME=sandbox

# ── MPESA STK Push (Daraja) — needed for real M-Pesa payments ───────────────
# Register at https://developer.safaricom.co.ke (sandbox first).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# MPESA_ENV=sandbox  # or "production"

# ── Exchange rates (optional) ────────────────────────────────────────────────
# Keyed plan at https://www.exchangerate-api.com (optional; free endpoint works).
EXCHANGE_RATE_API_KEY=
